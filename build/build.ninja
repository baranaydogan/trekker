  LANGUAGE_COMPILE_FLAGS = -O3 -DNDEBUG -W -Wall -Wextra -pedantic -pedantic-errors -Wno-long-long
  OBJECT_DIR = CMakeFiles/tmp.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = libtmp.a
  TARGET_PDB = tmp.a.dbg


#############################################
# Utility command for combined

build combined: phony CMakeFiles/combined libtmp.a


#############################################
# Utility command for libTrekker.a

build libTrekker.a: phony

# =============================================================================
# Object build statements for EXECUTABLE target trekker


#############################################
# Order-only phony target for trekker

build cmake_object_order_depends_target_trekker: phony || combined

build CMakeFiles/trekker.dir/src/cmd.cpp.o: CXX_COMPILER__trekker_Release /home/baran/Work/code/trekker/src/cmd.cpp || cmake_object_order_depends_target_trekker
  DEFINES = -DSHOWMANUAL="\"man /home/baran/Work/code/trekker/doc/build/man/trekker\""
  DEP_FILE = CMakeFiles/trekker.dir/src/cmd.cpp.o.d
  FLAGS = -O3 -DNDEBUG -W -Wall -Wextra -pedantic -pedantic-errors -Wno-long-long   -D HAVE_ZLIB -std=gnu++11
  OBJECT_DIR = CMakeFiles/trekker.dir
  OBJECT_FILE_DIR = CMakeFiles/trekker.dir/src


# =============================================================================
# Link build statements for EXECUTABLE target trekker


#############################################
# Link the executable trekker

build trekker: CXX_EXECUTABLE_LINKER__trekker_Release CMakeFiles/trekker.dir/src/cmd.cpp.o | libTrekker.a /usr/lib/libz.a || combined
  FLAGS = -O3 -DNDEBUG -W -Wall -Wextra -pedantic -pedantic-errors -Wno-long-long
  LINK_FLAGS = -static -static-libgcc -static-libstdc++ -Wl,--whole-archive -lpthread -Wl,--no-whole-archive
  LINK_LIBRARIES = libTrekker.a  /usr/lib/libz.a
  OBJECT_DIR = CMakeFiles/trekker.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = trekker
  TARGET_PDB = trekker.dbg


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/baran/Work/code/trekker/build && /usr/bin/ccmake -S/home/baran/Work/code/trekker -B/home/baran/Work/code/trekker/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/baran/Work/code/trekker/build && /usr/bin/cmake --regenerate-during-build -S/home/baran/Work/code/trekker -B/home/baran/Work/code/trekker/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build list_install_components: phony


#############################################
# Utility command for install

build CMakeFiles/install.util: CUSTOM_COMMAND all
  COMMAND = cd /home/baran/Work/code/trekker/build && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build install: phony CMakeFiles/install.util


#############################################
# Utility command for install/local

build CMakeFiles/install/local.util: CUSTOM_COMMAND all
  COMMAND = cd /home/baran/Work/code/trekker/build && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build install/local: phony CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build CMakeFiles/install/strip.util: CUSTOM_COMMAND all
  COMMAND = cd /home/baran/Work/code/trekker/build && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build install/strip: phony CMakeFiles/install/strip.util


#############################################
# Custom command for CMakeFiles/combined

build CMakeFiles/combined | ${cmake_ninja_workdir}CMakeFiles/combined: CUSTOM_COMMAND libtmp.a || OBJS libtmp.a
